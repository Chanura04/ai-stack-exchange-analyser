      "name": "66215d7b",
      "displayName": "User Reputation and Their Average Answer Scores",
      "queryLines": [
        "-- get a relationship if user has high reputation what is their avg_answer_score \r\n",
        "select avg(Score) as average_answer_score , Reputation, Id as UserID\r\n",
        "from default.marts_posts_users\r\n",
        "where PostType=\"Answer\"\r\n",
        "group by Id, Reputation"
      ]
    }
